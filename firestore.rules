rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function validFinance(d) {
      return !d.keys().hasAny(['totalAmount','combined','collaborators']) ||
        (d.keys().hasAll(['totalAmount','combined','collaborators'])
        && d.totalAmount is number && d.totalAmount >= 0 && d.totalAmount <= 1000000000
        && d.combined is bool && d.collaborators is list && d.collaborators.size() <= 20
        && ((d.combined && d.collaborators.size() > 0) || (!d.combined && d.collaborators.size() == 0))
        && d.price <= d.totalAmount);
    }
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','ownerId','client','profile','price','totalAmount','combined','collaborators','date','time','status','extensions','createdAt','completedAt','sheetUrl'])
        && d.keys().hasAll(['id','ownerId','client','profile','price','date','time','status','extensions'])
        && d.id is int && d.ownerId is string
        && d.client is string && d.client.size() > 0 && d.client.size() <= 80
        && d.profile is string && d.profile.size() > 0 && d.profile.size() <= 60
        && d.price is number && d.price >= 0 && validFinance(d)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && (d.time == '' || d.time.matches('^[0-9]{2}:[0-9]{2}$'))
        && (!d.keys().hasAny(['sheetUrl']) || (d.sheetUrl is string && d.sheetUrl.size() <= 2048 && (d.sheetUrl == '' || d.sheetUrl.matches('^https?://[^ ].* ['pending','completed']
        && d.extensions is int && d.extensions >= 0;
    }
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validProject();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId && validProject();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','image','joinedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.image is string && request.resource.data.image.size() <= 700000;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
))))
        && d.status in ['pending','completed']
        && d.extensions is int && d.extensions >= 0;
    }
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validProject();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId && validProject();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','image','joinedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.image is string && request.resource.data.image.size() <= 700000;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
